	quest.6B693FB6DFA646F7.quest_desc: [
		"获取盐的途径："
		"1.挖掘盐矿石，然后烧制获取"
		"2.寻找盐矿井结构，其中有盐水，盐水和水的性质一致，均可制作无限水"
		"{image:kubejs:textures/quest/quest_img8.png width:140 height:100 align:center}"
		"将盐水覆盖在营火上方时，一段时间后析出盐块，挖掘掉落盐（或是精准采集挖掘掉落盐块，然后研磨粗盐块获取盐）"
		"{image:kubejs:textures/quest/quest_img9.png width:140 height:100 align:center}"
	]
	quest.6B693FB6DFA646F7.title: "准备原料：盐"
